# Server
PORT=8080

# JWT Secret (change in production!)
JWT_SECRET=ledger_super_secret_key_change_in_production

# Dev Mode - skips real SMS sending, uses fixed code 123456
DEV_MODE=true

# Alibaba Cloud SMS (only needed in production)
SMS_ACCESS_KEY_ID=your_access_key_id
SMS_ACCESS_KEY_SECRET=your_access_key_secret
SMS_SIGN_NAME=账本APP
SMS_TEMPLATE_CODE=SMS_123456789
